<mjml>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px">
      <mj-column>

        <mj-text font-size="22px" font-weight="bold" align="center">
          Verify Your Email Address
        </mj-text>

        <mj-text align="center" color="#555">
          Thanks for signing up! Please verify your email address to complete your registration.
        </mj-text>

        <mj-divider />

        <mj-text align="center" font-size="16px">
          Your verification code:
        </mj-text>

        <mj-text
          align="center"
          font-size="26px"
          font-weight="bold"
          letter-spacing="4px"
          background-color="#f2f2f2"
          padding="15px"
        >
          {{CODE}}
        </mj-text>

        <mj-text align="center" color="#555">
          Alternatively, you can verify your account by clicking the button below:
        </mj-text>

        <mj-button
          background-color="#2563eb"
          color="#ffffff"
          href="{{VERIFY_URL}}"
          font-size="16px"
          padding="15px"
        >
          Verify My Email
        </mj-button>

        <mj-text align="center" font-size="12px" color="#888">
          If you didn’t sign up for this account, you can safely ignore this email.
        </mj-text>

      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
